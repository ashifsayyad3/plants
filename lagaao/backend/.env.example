# ─── App ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_NAME=Lagaao
APP_URL=http://localhost:3000

# ─── Database ──────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lagaao_db
DB_USER=root
DB_PASS=your_password

# Seeder admin password (used only by db:seed — change immediately after)
SEED_ADMIN_PASSWORD=Change@Me123!

# ─── JWT ──────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_64_char_random_hex
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_different_64_char_random_hex
JWT_REFRESH_EXPIRES_IN=7d

# ─── Auth Rate Limiting ────────────────────────────────
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# ─── Cookie ───────────────────────────────────────────
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost

# ─── Rate Limiting ─────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── CORS ──────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:4200

# ─── Swagger ───────────────────────────────────────────
SWAGGER_ENABLED=true

# ─── Mail (filled when mail module is added) ───────────
# MAIL_HOST=smtp.mailtrap.io
# MAIL_PORT=587
# MAIL_USER=
# MAIL_PASS=
# MAIL_FROM=noreply@lagaao.com

# ─── Storage ───────────────────────────────────────────
# STORAGE_DRIVER=local
# STORAGE_PATH=./uploads
# AWS_BUCKET=
# AWS_REGION=
# AWS_ACCESS_KEY=
# AWS_SECRET_KEY=
