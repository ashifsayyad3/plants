# ─────────────────────────────────────────────────────────────────────────────
# Lagaao — Production Environment Variables
# Copy to /var/www/lagaao/backend/.env  (chmod 600, owned by deploy user)
# NEVER commit the real .env to version control
# ─────────────────────────────────────────────────────────────────────────────

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
APP_NAME=Lagaao
APP_URL=https://lagaao.com

# ─── Database ─────────────────────────────────────────────────────────────────
# Create dedicated MySQL user — never use root in production
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lagaao_prod
DB_USER=lagaao_user
DB_PASS=CHANGE_THIS_STRONG_PASSWORD

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_64_CHAR_HEX_STRING
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_THIS_DIFFERENT_64_CHAR_HEX_STRING
JWT_REFRESH_EXPIRES_IN=7d

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# ─── CORS ────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://lagaao.com

# ─── Cookies ─────────────────────────────────────────────────────────────────
COOKIE_SECURE=true
COOKIE_DOMAIN=lagaao.com

# ─── Swagger (disable in production) ─────────────────────────────────────────
SWAGGER_ENABLED=false

# ─── Seed admin (only needed for first deploy, then remove or rotate) ─────────
SEED_ADMIN_PASSWORD=CHANGE_THIS_BEFORE_SEEDING
